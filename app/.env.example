# Copy to app/.env.local and fill in from the Firebase console:
#   Project settings > General > Your apps > SDK setup and configuration
#
# This configuration is PUBLIC. It identifies the project; it does not authorize
# anything. Access control comes from Firebase Auth, firestore.rules and the callable
# functions. Never put an Admin SDK service-account key in this file — it would be
# compiled straight into the browser bundle.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Set to run against the local Emulator Suite instead of a real project;
# when true, the values above can stay blank.
VITE_USE_EMULATORS=false

# Optional. reCAPTCHA Enterprise site key. App Check stays disabled until this is set.
VITE_RECAPTCHA_SITE_KEY=

# Optional. Only change if you deploy the functions to a different region.
VITE_FUNCTIONS_REGION=us-central1
